\begin{tblr}{width={524.4pt},colspec={@{}X[l,t,15.15343]X[l,t,168.10959]X[l,t,74.11115]X[l,t,84.03871]X[l,t,122.98715]@{}},row{1-1}={guard},colsep=6pt,stretch=1,rowsep=0pt}\tabletoprule
