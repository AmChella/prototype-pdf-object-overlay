    <!-- Author - ONLY in head > author-group -->
    <template data-xml-selector="head > author-group > author" xml:space="preserve">
\author[<apply-template data-xml-selector="cross-ref" mode="author-affil"/>]{\givenname{<apply-template data-xml-selector="given-name"/>}~\surname{<apply-template data-xml-selector="surname"/>}<apply-template data-xml-selector="contributor-role"/>}{}
</template>

