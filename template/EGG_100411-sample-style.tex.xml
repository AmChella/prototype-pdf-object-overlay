\affil[<apply-template data-xml-selector="label"/>]{\afflabel{[[@id | raw]]}<apply-template data-xml-selector="textfn"/>\saaffiliation{}}
</template>

    <template data-xml-selector="affiliation > label">[[.]]</template>
