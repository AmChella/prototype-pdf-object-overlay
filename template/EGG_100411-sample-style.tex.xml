<templates>
    <!-- Main document template for Elsevier EGG journal -->
    <template data-xml-selector="article" xml:space="preserve">
% Generated from EGG_100411.xml - Elsevier Article Template
\RequirePackage{ifxetex,ifluatex}%
\newif\iftagpdfsetup\tagpdfsetupfalse
\ifxetex\else\tagpdfsetupfalse\fi%

\ifxetex\else%
  \iftagpdfsetup%
    \DocumentMetadata{%
       lang=en,%
       testphase={phase-I},%
       pdfversion=1.7,%
       pdfstandard=ua-1,%
       uncompress,%
    }%
  \fi%
\fi%

\gdef\Templatepath{../layouts/elsevier/}

\documentclass[fleqn]{article}
\newif\iflinux\linuxtrue
\newif\ifbrowser\browserfalse
\newif\ifbookmarks\bookmarksfalse
\newif\ifCJK\CJKfalse
\newif\ifmultiauthgroup\multiauthgroupfalse
\newif\ifneedcutedpackage\needcutedpackagefalse
\usepackage[auproof]{\Templatepath autotemplate}
\input{../TeX-lib/geom-marks.tex}
\input{../TeX-lib/geom-marks-lines.tex}

% Define unhandledtag command for template fallback
\newcommand{\unhandledtag}[2]{#2}

\begin{document}
<apply-template data-xml-selector="item-info"/>

<apply-template data-xml-selector="floats"/>

\title{<apply-template data-xml-selector="head > title"/>}{title0010}

<apply-template data-xml-selector="head > author-group > author"/>

<apply-template data-xml-selector="head > author-group > affiliation"/>

\authoraffiliationend

<apply-template data-xml-selector="head > correspondence"/>

<apply-template data-xml-selector="head > email-addresses"/>

<apply-template data-xml-selector="head > date-received"/>
<apply-template data-xml-selector="head > date-revised"/>
<apply-template data-xml-selector="head > date-accepted"/>

\abstracttitle{Abstract}
\begin{abstract}
<apply-template data-xml-selector="head > abstract > abstract-sec > simple-para"/>
\end{abstract}

\highabstracttitle{Highlights}
\begin{authorhighlights}{}
\begin{neolistenv}
<apply-template data-xml-selector="head > abstract[class='author-highlights'] > abstract-sec > simple-para > list > list-item"/>
\begin{neoenumerate}
\tagStructListStart{}
<apply-template data-xml-selector="head > abstract[class='author-highlights'] > abstract-sec > simple-para > list > list-item" mode="detailed"/>
\tagStructListEnd{}
\end{neoenumerate}
\end{neolistenv}
\end{authorhighlights}

\keywordtext{Keywords}
<apply-template data-xml-selector="head > keywords > keyword"/>

\maketitle

<apply-template data-xml-selector="body > sections > section"/>

<apply-template data-xml-selector="body > acknowledgment"/>

\section{}{References}{}
\NumberedReferencestrue
\begin{thebibliography}{[000]}
<apply-template data-xml-selector="tail > bibliography > bibliography-sec > bib-reference"/>
\end{thebibliography}

\end{document}
    </template>

