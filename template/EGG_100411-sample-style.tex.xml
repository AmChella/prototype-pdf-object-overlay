\aid{<apply-template data-xml-selector="aid"/>}
\figaid{<apply-template data-xml-selector="aid"/>}
\articleno{<apply-template data-xml-selector="aid"/>}
\pii{<apply-template data-xml-selector="pii"/>}
\doi{<apply-template data-xml-selector="doi"/>}
\ccopyr{2025}
\journalspecificgatitlepage{no}
\gdef\SDISSN{24059854}
\journalname{Ecological Genetics and Genomics}
\journalnamealttext{Ecological Genetics and Genomics Cover Image}
\sdlineurl{https://www.elsevier.com/locate/egg}{www.elsevier.com/locate/egg}
\end{itemInfo}
    </template>

