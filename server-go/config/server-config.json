{
  "featureFlags": {
    "enableInstructionStack": true,
    "enableVersioning": true
  },
  "dropdownOptions": {
    "figure": [
      {
        "value": "placement_t",
        "label": "Placement: Top"
      },
      {
        "value": "placement_b",
        "label": "Placement: Bottom"
      },
      {
        "value": "placement_h",
        "label": "Placement: Here"
      },
      {
        "value": "placement_p",
        "label": "Placement: Float Page"
      }
    ],
    "paragraph": [
      {
        "value": "para_tight",
        "label": "Para Tight"
      },
      {
        "value": "para_loose",
        "label": "Para Loose"
      }
    ],
    "table": [
      {
        "value": "placement_t",
        "label": "Placement: Top"
      },
      {
        "value": "placement_b",
        "label": "Placement: Bottom"
      },
      {
        "value": "placement_h",
        "label": "Placement: Here"
      },
      {
        "value": "placement_p",
        "label": "Placement: Float Page"
      }
    ]
  },
  "xmlInstructionTemplates": {
    "figure": {
      "placement_t": "<instruction type=\"figure\" action=\"placement_t\" target=\"{elementId}\" />",
      "placement_b": "<instruction type=\"figure\" action=\"placement_b\" target=\"{elementId}\" />",
      "placement_h": "<instruction type=\"figure\" action=\"placement_h\" target=\"{elementId}\" />",
      "placement_p": "<instruction type=\"figure\" action=\"placement_p\" target=\"{elementId}\" />"
    },
    "paragraph": {
      "para_tight": "<instruction type=\"paragraph\" action=\"para_tight\" target=\"{elementId}\" spacing=\"tight\" />",
      "para_loose": "<instruction type=\"paragraph\" action=\"para_loose\" target=\"{elementId}\" spacing=\"loose\" />"
    },
    "table": {
      "placement_t": "<instruction type=\"table\" action=\"placement_t\" target=\"{elementId}\" />",
      "placement_b": "<instruction type=\"table\" action=\"placement_b\" target=\"{elementId}\" />",
      "placement_h": "<instruction type=\"table\" action=\"placement_h\" target=\"{elementId}\" />",
      "placement_p": "<instruction type=\"table\" action=\"placement_p\" target=\"{elementId}\" />"
    }
  },
  "xmlProcessingRules": {
    "figure": {
      "placement_t": {
        "xpath": "//*[local-name()='float-anchor'][@refid='{elementId}']",
        "operation": "setAttribute",
        "attribute": "placement",
        "value": "t"
      },
      "placement_b": {
        "xpath": "//*[local-name()='float-anchor'][@refid='{elementId}']",
        "operation": "setAttribute",
        "attribute": "placement",
        "value": "b"
      },
      "placement_h": {
        "xpath": "//*[local-name()='float-anchor'][@refid='{elementId}']",
        "operation": "setAttribute",
        "attribute": "placement",
        "value": "h"
      },
      "placement_p": {
        "xpath": "//*[local-name()='float-anchor'][@refid='{elementId}']",
        "operation": "setAttribute",
        "attribute": "placement",
        "value": "p"
      }
    },
    "paragraph": {
      "para_tight": {
        "xpath": "//*[local-name()='para'][@id='{elementId}']",
        "operation": "setAttribute",
        "attribute": "spacing",
        "value": "tight"
      },
      "para_loose": {
        "xpath": "//*[local-name()='para'][@id='{elementId}']",
        "operation": "setAttribute",
        "attribute": "spacing",
        "value": "loose"
      }
    },
    "table": {
      "placement_t": {
        "xpath": "//*[local-name()='float-anchor'][@refid='{elementId}']",
        "operation": "setAttribute",
        "attribute": "placement",
        "value": "t"
      },
      "placement_b": {
        "xpath": "//*[local-name()='float-anchor'][@refid='{elementId}']",
        "operation": "setAttribute",
        "attribute": "placement",
        "value": "b"
      },
      "placement_h": {
        "xpath": "//*[local-name()='float-anchor'][@refid='{elementId}']",
        "operation": "setAttribute",
        "attribute": "placement",
        "value": "h"
      },
      "placement_p": {
        "xpath": "//*[local-name()='float-anchor'][@refid='{elementId}']",
        "operation": "setAttribute",
        "attribute": "placement",
        "value": "p"
      }
    }
  },
  "texConversionRules": {
    "figure": {
      "placement_t": "\\begin{figure}[t]",
      "placement_b": "\\begin{figure}[b]",
      "placement_h": "\\begin{figure}[!h]",
      "default": "\\begin{figure}[htbp]"
    },
    "paragraph": {
      "spacing_tight": "\\setlength{\\parskip}{0.5em}",
      "spacing_loose": "\\setlength{\\parskip}{1.5em}",
      "default": "\\setlength{\\parskip}{1em}"
    },
    "table": {
      "orientation_landscape": "\\begin{landscape}\\begin{table}",
      "orientation_portrait": "\\begin{table}",
      "default": "\\begin{table}[htbp]"
    }
  },
  "fileSettings": {
    "xmlInput": "xml/document.xml",
    "texOutput": "TeX/document-generated.tex",
    "pdfOutput": "TeX/document-generated.pdf",
    "jsonOutput": "TeX/document-generated-marked-boxes.json",
    "uiOutputDir": "ui/"
  },
  "figurePositionSettings": {
    "storageFormat": "json",
    "enableJsonUpdate": true,
    "enableXmlUpdate": true,
    "jsonSettings": {
      "fileName": "satellite.json",
      "targetKey": "float_positions"
    },
    "xmlSettings": {
      "filePattern": "{journalId}_{articleId}.xml",
      "elementPath": "ce:figure[@id='{elementId}']"
    }
  }
}